# Copia este archivo como .env y completa los valores (el .env no se sube a git)

# Cuenta de Gmail que envía los correos (usar una "contraseña de aplicación" de Google)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Buzón de confirmaciones (Cloudflare Worker de la carpeta worker/)
CONFIRMACION_URL=https://registro-fcbiyt.fcbiyt-uatx.workers.dev
CONFIRMACION_API_KEY=

# Opcionales
# CONFIRMACION_HORAS_VIGENCIA=48
# CONFIRMACION_INTERVALO_SEG=60
# Guarda los correos como archivos en esta carpeta en lugar de enviarlos (para pruebas)
# CORREO_VISTA_PREVIA_DIR=
