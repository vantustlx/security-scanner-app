# Copia este archivo como .env y completa los valores (el .env no se sube a git)

# Base de datos MySQL (en producción, el usuario dedicado de db/usuario_app.sql, no root)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistemaaccesofacultad

# Acceso al modo administrador (la sesión se cierra tras ADMIN_INACTIVIDAD_MIN minutos sin uso)
ADMIN_USUARIO=
ADMIN_PASSWORD=
# ADMIN_INACTIVIDAD_MIN=10

# Firma de los QR de las credenciales. Si se deja vacío, la app genera uno al iniciar.
# RESPÁLDALO: si cambia o se pierde, todas las credenciales emitidas dejan de servir.
QR_SECRETO=
# "si" acepta temporalmente los QR anteriores (solo la matrícula) mientras se reenvían las credenciales
# QR_ACEPTAR_SIN_FIRMA=no

# Cuenta de Gmail que envía los correos (usar una "contraseña de aplicación" de Google)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Buzón de confirmaciones (Cloudflare Worker de la carpeta worker/)
CONFIRMACION_URL=https://registro-fcbiyt.fcbiyt-uatx.workers.dev
CONFIRMACION_API_KEY=

# Escáneres QR por puerto serie. Se llenan solos con "Configurar lectores" en la ventana del lector.
# 1 = peatonal (entrada y salida), 2 = entrada vehicular, 3 = salida vehicular
LECTOR_PEATONAL=
LECTOR_ENTRADA_VEHICULAR=
LECTOR_SALIDA_VEHICULAR=

# Cierre diario: PDF con quienes no registraron su salida y estatus Inactivo para todos
CIERRE_HORA=20:00

# Abre la app al iniciar sesión en Windows (solo en la PC de producción)
# INICIAR_CON_WINDOWS=si

# Opcionales
# CONFIRMACION_HORAS_VIGENCIA=48
# CONFIRMACION_INTERVALO_SEG=60
# LECTOR_BAUDIOS=9600
# Segundos en que se ignora el mismo QR en el mismo lector (el escáner relee mientras se sostiene)
# LECTOR_ANTIRREBOTE_SEG=8
# Carpeta de los PDF del cierre diario (por defecto: Documentos\Sistema de Acceso FCBIyT\Cierres)
# CIERRE_CARPETA=
# Guarda los correos como archivos en esta carpeta en lugar de enviarlos (para pruebas)
# CORREO_VISTA_PREVIA_DIR=
# Respaldo diario de la BD, después de la hora de cierre (por defecto: Documentos\Sistema de Acceso FCBIyT\Respaldos).
# Conviene una carpeta sincronizada (OneDrive, Google Drive) para tener copia fuera de la PC.
# RESPALDO_CARPETA=
# RESPALDO_DIAS=30
# RESPALDO_MYSQLDUMP=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
# Bitácora de la app, un archivo por día (por defecto: Documentos\Sistema de Acceso FCBIyT\Bitacora)
# BITACORA_CARPETA=
# BITACORA_DIAS=30
